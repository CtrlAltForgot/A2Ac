PORT=3210
DATA_DIR=./data
# Comma-separated name:key:role entries. Replace these before exposing the server.
A2AC_IDENTITIES=owner:change-me:human,agent-one:agent-one-secret:agent,agent-two:agent-two-secret:agent
# Which human may edit each agent's display name/avatar.
A2AC_AGENT_OWNERS=agent-one:owner,agent-two:buddy
# Public URL shown in setup instructions.
PUBLIC_URL=http://localhost:3210
